          "fire.adc",
          "fire.bluetooth",
          "fire.buttons",
          "fire.dac",
          "fire.display",
          "fire.gpio",
          "fire.i2c",
          "fire.imu",
          "fire.jobs",
          "fire.mic",
          "fire.power",
          "fire.pwm",
          "fire.rgb",
          "fire.rtc",
          "fire.sd",
          "fire.speaker",
          "fire.spi",
          "fire.time",
          "fire.uart",
