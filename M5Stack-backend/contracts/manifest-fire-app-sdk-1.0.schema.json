      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^0\\.1\\.[1-9][0-9]*$",
      "title": "Version",
      "type": "string"
    },
    "api_version": {
      "const": "fire-app-sdk-1.0",
