{
  "$defs": {
    "DataEngineExtension": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "fire-data-engine-1.0",
          "title": "Version",
          "type": "string"
        },
        "contract": {
          "const": "15a9ff7e5c68fc4d6dad8df9b4ab52b451f5e5a5dd2e20874881006c8e0eae8e",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract",
          "type": "string"
        }
      },
      "required": [
        "version",
        "contract"
      ],
      "title": "DataEngineExtension",
      "type": "object"
    },
    "RuntimeAICapability": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "fire-runtime-ai-1.0",
          "title": "Version",
          "type": "string"
        },
        "contract": {
          "const": "bef762941dad713217d70bbc1a9fd6cfbe7de825263dba246b5c170331ba4693",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract",
          "type": "string"
        }
      },
      "required": [
        "version",
        "contract"
      ],
      "title": "RuntimeAICapability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^0\\.1\\.[1-9][0-9]*$",
      "title": "Version",
      "type": "string"
    },
    "api_version": {
      "const": "fire-app-sdk-1.0",
      "type": "string"
    },
    "api_contract": {
      "const": "0e331b29dd23d94de670e4624fad44678158361e8c03b1401936a80de71089d9",
      "type": "string"
    },
    "entry": {
      "const": "main.lua",
      "default": "main.lua",
      "title": "Entry",
      "type": "string"
    },
    "required_services": {
      "items": {
        "enum": [
          "adc",
          "ai",
          "bluetooth",
          "buttons",
          "dac",
          "data",
          "display",
          "gpio",
          "i2c",
          "imu",
          "jobs",
          "mic",
          "power",
          "pwm",
          "rgb",
          "rtc",
          "sd",
          "speaker",
          "spi",
          "time",
          "uart",
          "wifi"
        ]
      },
      "title": "Required Services",
      "type": "array",
      "uniqueItems": true
    },
    "max_memory": {
      "default": 262144,
      "maximum": 262144,
      "minimum": 65536,
      "title": "Max Memory",
      "type": "integer"
    },
    "max_runtime_ms": {
      "default": 10000,
      "maximum": 10000,
      "minimum": 0,
      "title": "Max Runtime Ms",
      "type": "integer"
    },
    "permissions": {
      "items": {
        "enum": [
          "fire.adc",
          "fire.ai",
          "fire.bluetooth",
          "fire.buttons",
          "fire.dac",
          "fire.data",
          "fire.display",
          "fire.gpio",
          "fire.i2c",
          "fire.imu",
          "fire.jobs",
          "fire.mic",
          "fire.power",
          "fire.pwm",
          "fire.rgb",
          "fire.rtc",
          "fire.sd",
          "fire.speaker",
          "fire.spi",
          "fire.time",
          "fire.uart",
          "fire.wifi"
        ]
      },
      "title": "Permissions",
      "type": "array",
      "uniqueItems": true
    },
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "runtime_ai": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeAICapability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataEngineExtension"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "required_services",
    "permissions",
    "checksum",
    "api_version",
    "api_contract"
  ],
  "title": "Manifest",
  "type": "object",
  "allOf": [
    {
      "properties": {
        "required_services": {
          "contains": {
            "const": "display"
          }
        },
        "permissions": {
          "contains": {
            "const": "fire.display"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required_services": {
            "contains": {
              "const": "ai"
            }
          }
        }
      },
      "then": {
        "required": [
          "runtime_ai"
        ]
      },
      "else": {
        "properties": {
          "runtime_ai": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required_services": {
            "contains": {
              "const": "data"
            }
          }
        }
      },
      "then": {
        "required": [
          "data_engine"
        ]
      },
      "else": {
        "properties": {
          "data_engine": {
            "type": "null"
          }
        }
      }
    }
  ]
}
