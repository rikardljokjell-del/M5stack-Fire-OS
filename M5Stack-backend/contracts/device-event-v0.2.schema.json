  "required": [
    "device_id",
    "event",
    "event_id",
    "protocol_version",
    "type"
  ],
  "title": "DeviceEvent",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "app_repair_prepare"
          }
        }
      },
      "then": {
        "required": [
          "app_id"
        ],
        "properties": {
          "app_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "app_download"
          }
        }
      },
      "then": {
        "required": [
          "package_id"
        ],
        "properties": {
          "package_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "app_backend_delete_prepare"
          }
        }
      },
      "then": {
        "required": [
          "delete_scope"
        ],
        "properties": {
          "delete_scope": {
            "enum": [
              "version",
              "all"
            ],
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "app_backend_delete_confirm"
          }
        }
      },
      "then": {
        "required": [
          "delete_id"
        ],
        "properties": {
          "delete_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "firmware_store_result"
          }
        }
      },
      "then": {
        "required": [
          "firmware_id",
          "transfer_id",
          "status"
        ],
        "properties": {
          "firmware_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "transfer_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "failed"
            ],
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "text"
          }
        }
      },
      "then": {
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "maxLength": 4000,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "button"
          }
        }
      },
      "then": {
        "required": [
          "button",
          "action"
        ],
        "properties": {
          "button": {
            "enum": [
              "A",
              "B",
              "C"
            ],
            "type": "string"
          },
          "action": {
            "enum": [
              "pressed",
              "released",
              "long_pressed"
            ],
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "build_confirm"
          }
        }
      },
      "then": {
        "required": [
          "proposal_id"
        ],
        "properties": {
          "proposal_id": {
