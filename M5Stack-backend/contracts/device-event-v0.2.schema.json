{
  "$defs": {
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "default": "fire-lua-0.1",
          "enum": [
            "fire-lua-0.1",
            "fire-lua-0.2"
          ],
          "title": "Api Version",
          "type": "string"
        },
        "services": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "title": "Services",
          "type": "array"
        },
        "api_contract": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Contract"
        },
        "hardware": {
          "anyOf": [
            {
              "$ref": "#/$defs/HardwareResources"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_memory": {
          "maximum": 262144,
          "minimum": 65536,
          "title": "Max Memory",
          "type": "integer"
        },
        "max_runtime_ms": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Runtime Ms",
          "type": "integer"
        },
        "audio_input": {
          "default": false,
          "title": "Audio Input",
          "type": "boolean"
        },
        "audio_output": {
          "default": false,
          "title": "Audio Output",
          "type": "boolean"
        },
        "firmware_version": {
          "default": "unknown",
          "maxLength": 64,
          "title": "Firmware Version",
          "type": "string"
        },
        "firmware_storage": {
          "default": false,
          "title": "Firmware Storage",
          "type": "boolean"
        },
        "firmware_max_bytes": {
          "default": 4194304,
          "maximum": 4194304,
          "minimum": 1024,
          "title": "Firmware Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "services",
        "max_memory",
        "max_runtime_ms"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "DeviceApp": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "App Id",
          "type": "string"
        },
        "package_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
