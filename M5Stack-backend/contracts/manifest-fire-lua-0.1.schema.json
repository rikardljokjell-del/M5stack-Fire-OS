{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "icon": {
      "anyOf": [
        {
          "enum": [
            "icon.code",
            "icon.timer",
            "icon.calculator",
            "icon.crosshair",
            "icon.gamepad-2",
            "icon.battery",
            "icon.cloud-sun",
            "icon.clock",
            "icon.thermometer",
            "icon.lightbulb",
            "icon.house",
            "icon.bluetooth",
            "icon.wifi",
            "icon.radio",
            "icon.mic",
            "icon.volume-2",
            "icon.camera",
            "icon.zap",
            "icon.cpu",
            "icon.wrench",
            "icon.calendar-days",
            "icon.map-pin",
            "icon.compass",
            "icon.ruler",
            "icon.file-text",
            "icon.activity"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Icon"
    },
    "version": {
      "pattern": "^0\\.1\\.[1-9][0-9]*$",
      "title": "Version",
      "type": "string"
    },
    "api_version": {
      "const": "fire-lua-0.1",
      "default": "fire-lua-0.1",
      "title": "Api Version",
      "type": "string"
    },
    "entry": {
      "const": "main.lua",
      "default": "main.lua",
      "title": "Entry",
      "type": "string"
    },
    "required_services": {
      "items": {
        "enum": [
          "buttons",
          "display",
          "imu",
          "rgb",
          "time"
        ]
      },
      "title": "Required Services",
      "type": "array",
      "uniqueItems": true
    },
    "max_memory": {
      "default": 262144,
      "maximum": 262144,
      "minimum": 65536,
      "title": "Max Memory",
      "type": "integer"
    },
    "max_runtime_ms": {
      "default": 10000,
      "maximum": 10000,
      "minimum": 0,
      "title": "Max Runtime Ms",
      "type": "integer"
    },
    "permissions": {
      "items": {
        "enum": [
          "fire.buttons",
          "fire.display",
          "fire.imu",
          "fire.rgb",
          "fire.time"
        ]
      },
      "title": "Permissions",
      "type": "array",
      "uniqueItems": true
    },
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "required_services",
    "permissions",
    "checksum"
  ],
  "title": "Manifest",
  "type": "object"
}
