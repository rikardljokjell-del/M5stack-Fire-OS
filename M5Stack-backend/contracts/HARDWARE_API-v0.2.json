    "limits": {
      "jobs": 4,
      "io_calls_per_callback": 64,
      "io_bytes_per_callback": 2048,
      "result_bytes": 512,
      "text_bytes_per_callback": 256
    },
    "semantics": {
      "errors": "Invalid arguments or unannounced resources reject the app; operational failures return nil,error_code or a failed job.",
      "jobs": "Maximum 4 outstanding jobs; unique app-scoped IDs 1..65535. poll/result never block. Completion after operation, failure within 3000ms (mic.record duration+3000ms). cancel prevents future effects but cannot undo committed writes; close ALWAYS required even after cancellation. close cancels pending work. Exit cancels work and frees handles. Invalid handles return failed status/result or false.",
      "storage": "Only app-private relative paths, rooted at /apps/<id>/appdata/.",
      "real_io_on_pc": false,
      "i2c": "Bus numbers are logical OS broker handles, not free pin selectors. Write access also requires the advertised i2c_write_addresses allowlist. OS-owned IMU/power addresses must not be offered for writes.",
      "resources": "All pins/buses must be explicitly announced. The OS broker owns leases, preserves display/SD/PSRAM/conversation transport, and returns nil,busy for conflicts. GPIO mode must be configured before access. GPIO34..39 are input-only without internal pulls.",
      "network": "WiFi connect uses saved OS profile names, never secrets. Allow only bounded HTTP(S) requests, TLS certificate verification, 3000ms timeout, no token-bearing internal setup endpoints; OS may refuse disconnect/connect/sleep while conversation transport is in use. BLE/SPP coexistence/resource conflicts return busy/unavailable, never block.",
      "audio": "Mic/speaker access goes through the OS audio broker. Conversation capture/playback has priority. Return busy instead of corrupting active audio. mic.record writes mono PCM16 WAV; speaker.play accepts only bounded validated PCM16 mono WAV, 8/16/24kHz. tone finishes asynchronously. Stop/navigation must interrupt playback/recording.",
      "display": "OS clears offscreen sprite before every update and presents once. Render complete frame every update. grid uses dense row-major cell indices 0..palette length-1 and RGB565 palette; transparent cells are NOT supported. Batch rendering avoids long ASCII art.",
      "helpers": "Safe string/table functions are available in fire-lua-0.2 only. No format/rep/gsub/pattern VM, loaders or general libraries. String input/output at most 512 bytes; table helpers at most 128 elements.",
      "pc_limits": "All observations are deterministic fixtures, not native I/O. Virtual storage consumes bounded simulator memory; PC allocator includes trusted host baseline separately and conservatively charges app plus subsequent adapter allocations. Native allocator and timing still require hardware tests."
    },
    "environment": {
      "string": [
        "len",
        "sub",
        "byte",
        "char"
      ],
      "table": [
        "concat",
        "insert",
        "remove"
      ],
      "max_string_bytes": 512,
      "max_array_items": 128
    },
    "result_shapes": {
      "job_status": "{state=\"pending\"|\"ready\"|\"failed\"|\"cancelled\",done=boolean,error_code=string}",
      "job_result": "Before ready: {ok=false,error_code=\"not_ready\"}. Failed/cancelled: {ok=false,error_code=string}. Ready: {ok=true,...fields for method result}. Never throw for operational I/O failure.",
      "i2c_scan": "{ok=true,addresses={integer 1..126,...}}; at most 126 addresses, reads are nondestructive probes; register=-1 means raw read.",
      "bytes": "{ok=true,bytes={integer 0..255,...},text=string}; bytes is authoritative, text may be empty for binary data. Payload at most 512 bytes.",
      "write": "{ok=true,written=integer}; written is byte count for writes, 0 for control actions.",
      "uart": "{ok=true,text=string,bytes={integer 0..255,...}}; at most requested max_bytes. UART write is bounded text; SPI/I2C use byte arrays.",
      "wifi_status": "{connected=boolean,ssid=string,ip=string,rssi=integer}; successful connect job also has ok=true. No credentials.",
      "wifi_scan": "{ok=true,networks={{ssid=string,rssi=integer,secure=boolean},...}}; at most 8 entries, truncate UTF-8 SSID to 32 bytes.",
      "http": "{ok=true,status=integer,body=string}; body at most 512 bytes; overflow is failed job result_too_large, never unbounded buffering.",
      "bt_scan": "{ok=true,devices={{name=string,address=string,rssi=integer},...}}; at most 8 entries, name at most 32 bytes.",
      "handle": "{ok=true,handle=integer 1..65535}; app-scoped Bluetooth handle; maximum 4 live handles, close on exit.",
      "recording": "{ok=true,path=string,size_bytes=integer,sample_rate=integer}; mono PCM16 WAV in app-private storage.",
      "files": "{ok=true,entries={{name=string,size_bytes=integer,is_directory=boolean},...}}; bounded 32 entries, names at most 96 bytes.",
      "power_status": "{battery_percent=number,voltage=number,charging=boolean,usb=boolean}; voltage in V, percentage 0..100.",
      "clock": "{epoch=integer,year=integer,month=integer,day=integer,hour=integer,minute=integer,second=integer}; UTC, epoch seconds; OS software clock permitted if no RTC chip.",
      "vector": "{x=number,y=number,z=number}; accel in g, gyro in degrees/second; finite values.",
      "integer": "GPIO 0/1; ADC raw 0..4095 at fixed 12-bit configuration; time OS uptime milliseconds, may wrap.",
      "number": "mic.level normalized RMS 0..1; imu.temperature degrees Celsius."
    }
  }
}
