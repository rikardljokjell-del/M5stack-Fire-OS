# Copy to .env. Never commit .env or put the OpenAI key in a device.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_CODE_MODEL=gpt-6-luna
OPENAI_REVIEW_MODEL=gpt-6-luna
# Optional monetary/token caps. 0 means no limit in each numeric field.
FIRE_COST_LIMITS_ENABLED=false
FIRE_OUTPUT_LIMITS_ENABLED=false
FIRE_DAILY_BUDGET_USD=0
FIRE_BUILD_BUDGET_USD=0
FIRE_REQUEST_BUDGET_USD=0
FIRE_MAX_CORRECTIONS=0
FIRE_BACKEND_HOST=127.0.0.1
FIRE_BACKEND_PORT=8765
# openai is the normal mode. mock makes NO OpenAI requests.
FIRE_AI_MODE=openai
FIRE_WORKSPACE=workspace
# Required when binding to a LAN address. Sent as Authorization: Bearer TOKEN.
FIRE_BACKEND_TOKEN=
FIRE_BUILD_TIMEOUT_SECONDS=900
FIRE_MAX_WORKSPACE_MB=256
FIRE_MAX_BUILD_KB=512
FIRE_PROGRESS_INTERVAL_SECONDS=10

# Scoped physical/emulated devices. Each token must be unique and >=24 characters.
# Example structure: {"m5stack-fire-01":"replace-with-a-long-random-token"}
FIRE_DEVICE_TOKENS={}
# Optional PC -> FIRE transport for USB tethering; empty host keeps direct mode.
FIRE_REVERSE_HOST=
FIRE_REVERSE_PORT=8766
FIRE_REVERSE_DEVICE_ID=m5stack-fire-01
FIRE_SESSION_RESUME_SECONDS=600
FIRE_COMMAND_TIMEOUT_SECONDS=30
FIRE_AUDIO_ENABLED=false
# Only audible AI replies; disabling this keeps microphone/transcription active.
FIRE_SPEECH_ENABLED=true
FIRE_AUDIO_MAX_INPUT_BYTES=524288
FIRE_AUDIO_MAX_OUTPUT_BYTES=1440000
FIRE_AUDIO_TTL_SECONDS=300
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
